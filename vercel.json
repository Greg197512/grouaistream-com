{
  "redirects": [
    {
      "source": "/~oauth/initiate",
      "destination": "https://oauth.lovable.app/initiate?project_id=462bddcb-d545-4f42-bc51-5f437cb12bbe&project_env=prod",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
